NODE_ENV=development
PORT=8000
ADMIN_API_KEY=admin_secret_key_here
DATABASE_URL=postgresql://wagateway:wagateway123@localhost:5432/wagateway
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
DOCKER_SOCKET=/var/run/docker.sock
BOT_IMAGE=wa-bot:latest
SESSION_PATH=./sessions
MAX_MSG_PER_MINUTE=2
MAX_MSG_PER_HOUR=50
WARMUP_DAYS=7
DEVICE_MANAGER_URL=http://127.0.0.1:8001
DEVICE_MANAGER_PORT=8001
BOT_DOCKER_NETWORK=docker_default
SESSION_HOST_PATH=./sessions
ORCHESTRATOR=auto
# Legacy mode flags are also supported when ORCHESTRATOR=auto:
# DOCKER_MODE=true
# KUBERNETES_MODE=true
KUBERNETES_NAMESPACE=wa-gateway
# Leave empty for auto-detection from KUBERNETES_SERVICE_HOST
KUBERNETES_IN_CLUSTER=
BOT_STORAGE_CLASS=
BOT_SESSION_STORAGE_SIZE=1Gi

# Bot container (per-instance, di-inject oleh device-manager saat spawn container)
BOT_ID=bot_local_dev
BOT_CONTAINER_PORT=9000
MAX_RECONNECT_ATTEMPTS=5
# Comma-separated; kalau kosong fallback ke ADMIN_API_KEY. Isi 2 key saat rotasi
# (key lama + baru) lalu hapus yang lama setelah semua caller pindah.
BOT_API_KEYS=
