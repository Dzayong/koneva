NODE_ENV=development
PORT=8000
ADMIN_API_KEY=admin_secret_key_here
DATABASE_URL=postgresql://wagateway:wagateway123@localhost:5432/wagateway
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
DOCKER_SOCKET=/var/run/docker.sock
BOT_IMAGE=wa-bot:latest
SESSION_PATH=./sessions
MAX_MSG_PER_MINUTE=2
MAX_MSG_PER_HOUR=50
WARMUP_DAYS=7
DEVICE_MANAGER_URL=http://127.0.0.1:8001
DEVICE_MANAGER_PORT=8001
BOT_DOCKER_NETWORK=docker_default
SESSION_HOST_PATH=./sessions
ORCHESTRATOR=auto
# Legacy mode flags are also supported when ORCHESTRATOR=auto:
# DOCKER_MODE=true
# KUBERNETES_MODE=true
KUBERNETES_NAMESPACE=wa-gateway
# Leave empty for auto-detection from KUBERNETES_SERVICE_HOST
KUBERNETES_IN_CLUSTER=
BOT_STORAGE_CLASS=
BOT_SESSION_STORAGE_SIZE=1Gi

# Bot container (per-instance, di-inject oleh device-manager saat spawn container)
BOT_ID=bot_local_dev
BOT_CONTAINER_PORT=9000
MAX_RECONNECT_ATTEMPTS=5
# Comma-separated; kalau kosong fallback ke ADMIN_API_KEY. Isi 2 key saat rotasi
# (key lama + baru) lalu hapus yang lama setelah semua caller pindah.
BOT_API_KEYS=

# --- Panel Operator (dinonaktifkan secara default; lihat docs/OPERATOR_PANEL.md) ---
# OPERATOR_ENABLED=false
# OPERATOR_ALLOWED_ORIGIN=https://panel.example.com
# OPERATOR_COOKIE_NAME=__Host-koneva_op
# OPERATOR_COOKIE_SECURE=true
# OPERATOR_ALLOW_PRODUCTION=false        # true hanya setelah checklist di docs/OPERATOR_PANEL.md
# OPERATOR_IDEMPOTENCY_RETENTION_DAYS=7  # minimal 3 (janji replay 72 jam)
# TRUST_PROXY_HOPS=1                     # jumlah proxy di depan API
# ADMIN_ALLOWED_NETWORKS=loopback,private  # /admin lama; default produksi sama; 'any' menonaktifkan pembatasan
# ADMIN_LEGACY_BILLING_WRITES=false      # true = izinkan /admin pay & student-verify walau panel aktif

# --- Email OTP invitations (Gmail API OAuth; disabled by default) ---
# Signup WhatsApp sender is paired from Operator → OTP WhatsApp by scanning its QR code.
# EMAIL_TRANSPORT=none                    # none | dev-outbox | gmail-api
# GMAIL_SENDER_EMAIL=otp.sender@gmail.com
# GMAIL_OAUTH_CLIENT_ID=<OAuth client ID>
# GMAIL_OAUTH_CLIENT_SECRET=<secret; keep in local secret storage, never commit>
# GMAIL_OAUTH_REFRESH_TOKEN=<gmail.send refresh token; keep secret, never commit>
# OTP_SENDER_DAILY_CAP=200          # OTP sends across channels per rolling 24 h for the whole system (1..100000); 70% is logged
