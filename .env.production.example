NODE_ENV=production
DOMAIN=wa.example.com
LETSENCRYPT_EMAIL=admin@example.com
POSTGRES_DB=wagateway
POSTGRES_USER=wagateway_prod
POSTGRES_PASSWORD=generate_with_openssl_rand_hex_32
DATABASE_URL=postgresql://wagateway_prod:password@postgres:5432/wagateway
REDIS_PASSWORD=generate_with_openssl_rand_hex_32
REDIS_URL=redis://:password@redis:6379
JWT_SECRET=generate_with_openssl_rand_hex_64
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=generate_with_openssl_rand_hex_48
WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
BOT_API_KEYS=generate_with_openssl_rand_hex_24
DOCKER_SOCKET=/var/run/docker.sock
BOT_IMAGE=wa-bot:latest
BOT_DOCKER_NETWORK=wa-gateway-backend
SESSION_PATH=/app/sessions
SESSION_HOST_PATH=/opt/wa-gateway/sessions
MAX_MSG_PER_MINUTE=2
MAX_MSG_PER_HOUR=50
WARMUP_DAYS=7
DEVICE_MANAGER_URL=http://device-manager:8001
DEVICE_MANAGER_PORT=8001
IMAGE_TAG=latest
DOCKER_GID=999
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate_with_openssl_rand_hex_24
BACKUP_RETENTION_DAYS=7
S3_BUCKET=
S3_PREFIX=wa-gateway/backups
AWS_REGION=ap-southeast-1
