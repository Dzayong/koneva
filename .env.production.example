NODE_ENV=production
DOMAIN=wa.example.com
LETSENCRYPT_EMAIL=admin@example.com
POSTGRES_DB=wagateway
POSTGRES_USER=wagateway_prod
POSTGRES_PASSWORD=generate_with_openssl_rand_hex_32
DATABASE_URL=postgresql://wagateway_prod:password@postgres:5432/wagateway
REDIS_PASSWORD=generate_with_openssl_rand_hex_32
REDIS_URL=redis://:password@redis:6379
JWT_SECRET=generate_with_openssl_rand_hex_64
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=generate_with_openssl_rand_hex_48
WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
BOT_API_KEYS=generate_with_openssl_rand_hex_24
DOCKER_SOCKET=/var/run/docker.sock
BOT_IMAGE=wa-bot:latest
BOT_DOCKER_NETWORK=wa-gateway-backend
SESSION_PATH=/app/sessions
SESSION_HOST_PATH=/opt/wa-gateway/sessions
MAX_MSG_PER_MINUTE=2
MAX_MSG_PER_HOUR=50
WARMUP_DAYS=7
DEVICE_MANAGER_URL=http://device-manager:8001
DEVICE_MANAGER_PORT=8001
IMAGE_TAG=latest
DOCKER_GID=999
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate_with_openssl_rand_hex_24
BACKUP_RETENTION_DAYS=7
S3_BUCKET=
S3_PREFIX=wa-gateway/backups
AWS_REGION=ap-southeast-1

# --- Email OTP invitations (Gmail API OAuth; leave disabled until Google OAuth is verified) ---
# EMAIL_TRANSPORT=none
# GMAIL_SENDER_EMAIL=<verified sender address>
# GMAIL_OAUTH_CLIENT_ID=<OAuth client ID>
# GMAIL_OAUTH_CLIENT_SECRET=<secret-manager reference/value; never commit>
# GMAIL_OAUTH_REFRESH_TOKEN=<secret-manager reference/value; never commit>

# --- Panel Operator (dinonaktifkan secara default; lihat docs/OPERATOR_PANEL.md) ---
# OPERATOR_ENABLED=false
# OPERATOR_ALLOWED_ORIGIN=https://panel.example.com
# OPERATOR_MFA_ENC_KEY=<base64 dari 32 byte acak: head -c 32 /dev/urandom | base64>   # JANGAN commit nilai asli
# OPERATOR_COOKIE_NAME=__Host-koneva_op
# OPERATOR_COOKIE_SECURE=true
# OPERATOR_ALLOW_PRODUCTION=false        # true hanya setelah checklist di docs/OPERATOR_PANEL.md
# OPERATOR_IDEMPOTENCY_RETENTION_DAYS=7  # minimal 3 (janji replay 72 jam)
# TRUST_PROXY_HOPS=1                     # jumlah proxy di depan API
# ADMIN_ALLOWED_NETWORKS=loopback,private  # /admin lama; default produksi sama; 'any' menonaktifkan pembatasan
# ADMIN_LEGACY_BILLING_WRITES=false      # true = izinkan /admin pay & student-verify walau panel aktif
# OTP_SENDER_DAILY_CAP=200          # email OTPs per rolling 24 h for the whole system (1..100000); 70% is logged
