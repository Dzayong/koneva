apiVersion: v1
kind: Secret
metadata:
  name: wa-gateway-secrets
  namespace: wa-gateway
  labels:
    app.kubernetes.io/name: wa-gateway
    app.kubernetes.io/part-of: wa-gateway
type: Opaque
stringData:
  DATABASE_URL: "postgresql://wagateway:CHANGE_ME@postgres:5432/wagateway"
  REDIS_URL: "redis://:CHANGE_ME@redis:6379"
  JWT_SECRET: "CHANGE_ME_GENERATE_AT_LEAST_64_RANDOM_BYTES"
  ADMIN_API_KEY: "CHANGE_ME_GENERATE_AT_LEAST_48_RANDOM_BYTES"
  ENCRYPTION_KEY: "CHANGE_ME_GENERATE_32_RANDOM_BYTES"
  POSTGRES_DB: "wagateway"
  POSTGRES_USER: "wagateway"
  POSTGRES_PASSWORD: "CHANGE_ME"
  REDIS_PASSWORD: "CHANGE_ME"
---
apiVersion: v1
kind: Secret
metadata:
  name: wa-gateway-ai-secrets
  namespace: wa-gateway
type: Opaque
stringData:
  AI_REPLY_ENCRYPTION_KEY: ""
