# Copy to .env.personal, or let `make start` generate strong local secrets.
# This is also a trusted shell file: quote values with spaces. Never commit it.
DB_USER=wagateway
DB_NAME=wagateway
# URL-safe random values (openssl rand -hex 32); no placeholder defaults.
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
ADMIN_API_KEY=
# Separate API/device-manager DB login; generated privately by start-personal.sh.
APP_DB_PASSWORD=

# Dedicated personal ports avoid the development stack's usual ports.
API_PORT=18000
MANAGER_PORT=18001
DASHBOARD_PORT=13000
DB_PORT=55432
REDIS_PORT=56379
APP_BIND_ADDRESS=127.0.0.1
PERSONAL_PROJECT=wa-personal
BOT_DOCKER_NETWORK=wa-gateway-personal
# Optional absolute path, default: <repo>/data/personal/sessions
SESSION_HOST_PATH=
BACKUP_DIR=
RETENTION_DAYS=7
BACKUP_ENABLED=true
BACKUP_SCHEDULE='0 3 * * *'
# Optional nginx. Set COMPOSE_PROFILES=with-nginx to enable HTTP proxy.
COMPOSE_PROFILES=
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=localhost
EMAIL=

# Optional: route WhatsApp traffic through one stable egress IP per deployment.
# Leave empty to use this machine's own (residential) IP, which is the safest
# choice for a personal number. Supported: socks5://user:pass@host:port, http://host:port
WA_PROXY_URL=

# Manual billing: shown to the owner on the Tagihan page after ordering.
# PAYMENT_INSTRUCTIONS supports newlines with \n.
PAYMENT_INSTRUCTIONS="Transfer ke rekening yang diberikan penyedia layanan."
OPERATOR_CONTACT=
OPERATOR_BREAK_GLASS_ALERT_EMAIL=koneva.id26@gmail.com
